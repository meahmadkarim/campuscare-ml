# =============================================================================
# 1. Python Cache, Compiled Files, and Packaging
# =============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions & Cython debug symbols
*.so
cython_debug/

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script, before PyInstaller builds the exe, so may be non-existent
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Translations
*.mo
*.pot

# Framework & documentation build artifacts
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.webassets-cache
.scrapy
docs/_build/
/site
.pybuilder/
target/

# IPython & SageMath
profile_default/
ipython_config.py
*.sage.py

# PEP 582; used by e.g. github.com/fannheyward/coc-pyright
__pypackages__/

# Celery
celerybeat-schedule
celerybeat.pid

# Static type checkers & linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Package manager notes (preserved from template)
# .python-version
# Pipfile.lock
# poetry.lock
# .pdm-python
# .pdm-build/

# =============================================================================
# 2. Virtual Environments
# =============================================================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# =============================================================================
# 3. Environment Variables and Secrets
# =============================================================================
.env
.env.*
!.env.example
!.env.sample
!.env.template

# =============================================================================
# 4. IDE and Operating System Temporary Files
# =============================================================================
# IDEs and editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.spyderproject
.spyproject
.ropeproject
*.swp
*.swo
*~

# Explicitly preserve committed VS Code multi-root workspace file
!CampusCare-ML.code-workspace

# Operating system files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# =============================================================================
# 5. Python Testing and Coverage Outputs
# =============================================================================
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# =============================================================================
# 6. Temporary ML Experiments, Logs, and Generated Artifacts
# =============================================================================
# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Experiment tracking and runtime logs
*.log
logs/
tensorboard/
wandb/
mlruns/
runs/
outputs/
checkpoints/
tmp/
temp/

# Note: Datasets and final trained models are intentionally NOT blanket-ignored
# here; dataset and model tracking decisions are managed separately.
# models/
# *.pth
# *.pt
# *.pkl
# *.h5
# *.joblib
# data/
# datasets/
# *.csv
