{
	"folders": [
		{
			"name": "CampusCare-ML | Main",
			"path": "."
		},
		{
			"name": "CampusCare-ML | Codex",
			"path": ".worktrees/codex"
		},
		{
			"name": "CampusCare-ML | Claude",
			"path": ".worktrees/claude"
		},
		{
			"name": "CampusCare-ML | Antigravity",
			"path": ".worktrees/antigravity"
		}
	],
	"settings": {
		"editor.tabSize": 4,
		"editor.insertSpaces": true,
		"files.eol": "\n",
		"files.insertFinalNewline": true,
		"files.trimTrailingWhitespace": true,
		"[python]": {
			"editor.tabSize": 4,
			"editor.insertSpaces": true
		},
		"python.analysis.autoSearchPaths": true,
		"python.analysis.indexing": true,
		"python.terminal.activateEnvironment": true,
		"terminal.integrated.defaultProfile.windows": "PowerShell",
		"files.exclude": {
			"**/__pycache__": true,
			"**/.pytest_cache": true,
			"**/.mypy_cache": true,
			"**/.ruff_cache": true
		},
		"search.exclude": {
			"**/.venv": true,
			"**/venv": true,
			"**/__pycache__": true,
			"**/.pytest_cache": true,
			"**/.mypy_cache": true,
			"**/.ruff_cache": true
		},
		"git.enabled": true,
		"git.autoRepositoryDetection": "subFolders",
		"git.enableSmartCommit": false,
		"git.autofetch": false
	}
}
